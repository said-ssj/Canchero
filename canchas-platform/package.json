{
  "name": "canchas-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run start --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "test:web": "npm run test --workspace=apps/web",
    "lint:web": "npm run lint --workspace=apps/web",
    "dev:api": "cd apps/api && ./mvnw spring-boot:run",
    "build:api": "cd apps/api && ./mvnw clean package",
    "test:api": "cd apps/api && ./mvnw test",
    "supabase:start": "supabase start",
    "supabase:functions:deploy": "supabase functions deploy",
    "db:generate:types": "supabase gen types typescript --project-id ibnnkjqcmionynytkqqh > packages/types/supabase.types.ts",
    "prepare": "cd .. && husky .husky"
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "lint-staged": "^17.6.0"
  },
  "lint-staged": {
    "apps/web/src/**/*.{ts,html,css}": "prettier --write"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "npm@11.17.0"
}
