# ==============================================================================
# CANCHERO - Plantilla de Variables de Entorno (.env.example)
# Copiar este archivo a .env.local para desarrollo local (nunca commitear .env.local)
# Para guia detallada de cada servicio, ver: docs/GUIA_CREDENCIALES_Y_SERVICIOS.md
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CONFIGURACIÓN BÁSICA PARA ARRANQUE LOCAL Y NUBE (REQUERIDO)
# ------------------------------------------------------------------------------

# Frontend Angular (consumido via scripts/load-env.mjs -> environment.local.ts)
# La URL debe usar https:// (o http:// en localhost). La clave debe ser anon/publishable, nunca service_role.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# URL de la API del Backend consumida por el Frontend
# Local: http://localhost:8080/api
# Producción en Vercel: URL pública del servicio en Render (ej. https://canchero-api.onrender.com/api)
API_URL=http://localhost:8080/api

# Backend Spring Boot (consumido via scripts/start-api.ps1 y application.yml)
# En local con PostgreSQL directo o via Session pooler de Supabase:
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-database-password

# Origenes exactos separados por coma. En Render: https://TU-FRONTEND.vercel.app
# No usar comodines, rutas ni credenciales.
CORS_ALLOWED_ORIGINS=http://localhost:4200
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1

# Firma privada de sesiones de Spring; no es la clave pública de Supabase.
APP_AUTH_TOKEN_SECRET=your-app-session-secret-min-32-chars
# Compatibilidad temporal: instalaciones existentes pueden conservar SUPABASE_JWT_SECRET.
# No rotar ese valor sin planificar la caducidad de las sesiones existentes.
# SUPABASE_JWT_SECRET=existing-legacy-session-secret

# Puente JWT de cinco minutos. Activar tras aplicar la migración de permisos y probar la firma.
# Nunca enviar estos valores privados a Vercel ni al navegador.
SUPABASE_REALTIME_AUTH_ENABLED=false
# Debe ser una firma HS256 realmente aceptada por ESTE proyecto de Supabase.
# No sirve un secreto aleatorio ni la clave publishable/anon. Ver docs/AUTH_SUPABASE_JWT.md.
SUPABASE_REALTIME_JWT_SECRET=

# ------------------------------------------------------------------------------
# 2. SERVICIOS OPCIONALES
# ------------------------------------------------------------------------------

# Google Maps Platform (Opcional - para mapas interactivos del frontend)
GOOGLE_MAPS_API_KEY=your-google-maps-browser-key

# Habilitar después de configurar Google en Supabase y aplicar el SQL revisado.
GOOGLE_AUTH_ENABLED=false

# ------------------------------------------------------------------------------
# 3. PROVEEDORES PENDIENTES / INTEGRACIONES FUTURAS (NO REQUERIDOS PARA ARRANQUE)
# Estos servicios corresponden a fases futuras o módulos diferidos.
# NO son necesarios para compilar ni ejecutar el MVP activo.
# ------------------------------------------------------------------------------

# Pasarela de Pagos Culqi (Actualmente opera en modo simulación autoritativa en backend)
# CULQI_PUBLIC_KEY=pk_test_xxx
# CULQI_SECRET_KEY=sk_test_xxx
# CULQI_WEBHOOK_SECRET=whsec_xxx

# Facturación Electrónica SUNAT
# SUNAT_RUC=20123456789
# SUNAT_USER=MODDATOS
# SUNAT_PASSWORD=your-password
# SUNAT_ENDPOINT=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService

# Mensajería WhatsApp / SMS (Twilio)
# TWILIO_ACCOUNT_SID=ACxxx
# TWILIO_AUTH_TOKEN=xxx
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Correo transaccional. Resend es preferido; Brevo sigue disponible para recuperación de acceso.
# Sin claves no se envían correos ni se escriben enlaces/tokens en logs.
# El remitente debe estar verificado en Brevo (Senders, Domains & Dedicated IPs > Senders).
# BREVO_API_KEY=xkeysib-xxx
# MAIL_FROM_EMAIL=tu-correo-verificado@gmail.com
# URL publica de la web para armar el enlace del correo (en produccion: https://TU-FRONTEND.vercel.app)
# APP_PUBLIC_URL=http://localhost:4200

# Resend: configurar SOLO en la API/Render, nunca en Vercel ni en Angular.
# RESEND_API_KEY=re_REEMPLAZAR_EN_LOCAL
# MAIL_FROM_EMAIL=reservas@TU_DOMINIO_VERIFICADO
BOOKING_EMAILS_ENABLED=false

# Clima: prototipo no comercial con Open-Meteo. Uso comercial requiere su licencia.
WEATHER_ENABLED=true
# OPEN_METEO_API_KEY=REEMPLAZAR_EN_LOCAL

# Notificaciones Push (Firebase Cloud Messaging)
# FCM_SERVER_KEY=xxx
# FCM_SENDER_ID=xxx

# Monitoreo y Telemetría
# Sentry: proyectos separados para Angular y API. Sin DSN/activación no transmite datos.
SENTRY_ENABLED=false
# SENTRY_FRONTEND_DSN=https://CLAVE_PUBLICA@TU_HOST_INGEST/ID_PROYECTO
# SENTRY_BACKEND_DSN=https://CLAVE_PUBLICA@TU_HOST_INGEST/ID_PROYECTO
APP_ENVIRONMENT=development
# APP_RELEASE=revision-git
# GRAFANA_API_KEY=xxx

# Mercado Pago Checkout Pro: SOLO prueba; todas estas variables van en API/Render.
# No habilitar hasta aplicar la migracion y configurar Webhooks.
MERCADOPAGO_ENABLED=false
# MERCADOPAGO_ACCESS_TOKEN=credencial-del-vendedor-de-prueba
# MERCADOPAGO_COLLECTOR_ID=id-del-vendedor-de-prueba
# MERCADOPAGO_WEBHOOK_SECRET=firma-secreta-de-Webhooks
# MERCADOPAGO_PASS_SECRET=secreto-aleatorio-privado-minimo-32-caracteres
MERCADOPAGO_PUBLIC_URL=https://canchero-iota.vercel.app
MERCADOPAGO_WEBHOOK_URL=https://canchero-api-givn.onrender.com/api/payments/mercadopago/webhook
