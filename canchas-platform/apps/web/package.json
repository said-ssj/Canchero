    "prestart": "node scripts/load-env.mjs",
    "start": "ng serve",
    "prebuild": "node scripts/load-env.mjs",
    "build": "ng build",
    "prewatch": "node scripts/load-env.mjs",
    "watch": "ng build --watch --configuration development",
    "pretest": "node scripts/load-env.mjs",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
